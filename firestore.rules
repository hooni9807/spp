rules_version = '2';
// SPP ranking: anyone may read the boards; only signed-in players (Google, or Naver via the custom-token worker) add a
// well-formed record; nobody may edit or delete. Guest (anonymous) accounts are not accepted.
service cloud.firestore {
  match /databases/{database}/documents {
    function valid(maxValue) {
      let d = request.resource.data;
      return request.auth != null && request.auth.token.firebase.sign_in_provider in ['google.com', 'custom']
        && d.keys().hasOnly(['name', 'ttl', 'value', 'level', 'character', 'racket', 'detail', 'streak', 'at'])
        && (!('ttl' in d) || d.ttl is string && d.ttl.size() <= 12)
        && d.keys().hasAll(['name', 'value', 'level', 'character', 'racket', 'detail', 'at'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 12
        && d.value is int && d.value >= 1 && d.value <= maxValue
        && d.level is string && d.level.size() <= 10
        && d.character is string && d.character.size() <= 10
        && d.character in ['매혹범', '휴고범', '리신범', '퍼시벌', '만취범', '아재범', '민희쌤', '일병3호봉', '빽종령', '금호관장', '송스타', '날먹세', '김치성', '지킬앤 하이범', '아담 성', '올인 도박사', '유리대포']
        && d.racket is string && d.racket.size() <= 10
        && d.detail is string && d.detail.size() <= 20
        && (!('streak' in d) || d.streak is int && d.streak >= 0 && d.streak <= 9999)
        && d.at == request.time;
    }
    match /rally/{id} {
      allow read: if true;
      allow create: if valid(10000);
    }
    // 최고 랠리 by mode (new records): rally_ai_e · _h · _ex · _u · _uh · _uex · _unm (AI 대전 난이도별), rally_rank (랭크전), rally_inf (무한 드라이브), rally_boss (보스전),
    // rally_doubles (복식), rally_trio (3인 대전). The old mixed /rally collection above stays readable.
    match /rally_ai_e/{id} {
      allow read: if true;
      allow create: if valid(10000);
    }
    match /rally_ai_h/{id} {
      allow read: if true;
      allow create: if valid(10000);
    }
    match /rally_ai_ex/{id} {
      allow read: if true;
      allow create: if valid(10000);
    }
    match /rally_ai_u/{id} {
      allow read: if true;
      allow create: if valid(10000);
    }
    match /rally_ai_uh/{id} {
      allow read: if true;
      allow create: if valid(10000);
    }
    match /rally_ai_uex/{id} {
      allow read: if true;
      allow create: if valid(10000);
    }
    match /rally_ai_unight/{id} {
      allow read: if true;
      allow create: if valid(10000);
    }
    match /rally_ai_unm/{id} {
      allow read: if true;
      allow create: if valid(10000);
    }
    match /rally_rank/{id} {
      allow read: if true;
      allow create: if valid(10000);
    }
    match /rally_inf/{id} {
      allow read: if true;
      allow create: if valid(10000);
    }
    match /rally_survival/{id} {
      allow read: if true;
      allow create: if valid(10000);
    }
    // 스테이지 돌파전: value = 돌파한 스테이지 수
    match /rally_stage/{id} {
      allow read: if true;
      allow create: if valid(10000);
    }
    match /rally_boss/{id} {
      allow read: if true;
      allow create: if valid(10000);
    }
    match /rally_doubles/{id} {
      allow read: if true;
      allow create: if valid(10000);
    }
    match /rally_trio/{id} {
      allow read: if true;
      allow create: if valid(10000);
    }
    // AI 대전 승리 점수: 난이도 기본점수 + 승점 차 + 투터치 + 무실점 + 연승 보너스
    match /wins/{id} {
      allow read: if true;
      allow create: if valid(10000);
    }
    // 보스 클리어: point gap x100 + that match's best rally (max 99)
    match /boss/{id} {
      allow read: if true;
      allow create: if valid(10000);
    }
    // Mid-game exits are kept out of every leaderboard collection.
    match /quit_records/{id} {
      allow create: if valid(10000);
    }

    // PvP rating. Google-signed-in players only; each may only write its own doc, one result at a time,
    // with the exact rating step: win +9+streak (10, 11, 12 ...), loss -9+streak (-10, -11, -12 ...).
    function pvpShape(d) {
      return d.keys().hasOnly(['name', 'ttl', 'rating', 'wins', 'losses', 'streak', 'at'])
        && (!('ttl' in d) || d.ttl is string && d.ttl.size() <= 12)
        && d.keys().hasAll(['name', 'rating', 'wins', 'losses', 'streak', 'at'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 12
        && d.rating is int && d.wins is int && d.losses is int && d.streak is int
        && d.at == request.time;
    }
    // Game setup per Google account (racket, blade, rubber, difficulty, character): only the owner reads or writes it.
    match /settings/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider in ['google.com', 'custom']
        && request.resource.data.keys().hasOnly(['racket', 'blade', 'rubber', 'difficulty', 'character', 'lastCharacter', 'aiTier', 'at'])
        && request.resource.data.keys().hasAll(['racket', 'blade', 'rubber', 'difficulty', 'character', 'lastCharacter', 'aiTier', 'at'])
        && request.resource.data.racket is string && request.resource.data.racket.size() <= 12
        && request.resource.data.blade is string && request.resource.data.blade.size() <= 12
        && request.resource.data.rubber is string && request.resource.data.rubber.size() <= 12
        && request.resource.data.difficulty is string && request.resource.data.difficulty.size() <= 12
        && request.resource.data.character is string && request.resource.data.character.size() <= 12
        && request.resource.data.lastCharacter is string && request.resource.data.lastCharacter.size() <= 12
        && request.resource.data.aiTier is string && request.resource.data.aiTier in ['easy', 'hard', 'extreme', 'ultra', 'uhard', 'uext', 'unight']
        && request.resource.data.at == request.time;
    }
    // Public matchmaking: a waiting host lists its own room (4-letter PeerJS code); anyone may read the list.
    match /rooms/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider in ['google.com', 'custom']
        && request.resource.data.keys().hasOnly(['code', 'name', 'rating', 'kind', 'n', 'at'])
        && request.resource.data.keys().hasAll(['code', 'name', 'rating', 'at'])
        && request.resource.data.code is string && request.resource.data.code.matches('^[A-Z0-9]{4}$')
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 12
        && request.resource.data.rating is int
        && request.resource.data.at == request.time;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // 칭호 (ttl): optional title id on ranking rows, PvP, presence and level rows.
    // 친구창: who is online. Each signed-in player writes only its own presence doc.
    match /presence/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider in ['google.com', 'custom']
        && request.resource.data.keys().hasOnly(['name', 'ttl', 'status', 'at'])
        && (!('ttl' in request.resource.data) || request.resource.data.ttl is string && request.resource.data.ttl.size() <= 12)
        && request.resource.data.keys().hasAll(['name', 'status', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 12
        && request.resource.data.status is string && request.resource.data.status.size() <= 12
        && request.resource.data.at == request.time;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // 레벨 · 캐릭터 해금: each account reads and writes only its own progress.
    match /progress/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider in ['google.com', 'custom']
        && request.resource.data.keys().hasOnly(['xp', 'unlocked', 'q', 'runes', 'runeSets', 'at'])
        && request.resource.data.keys().hasAll(['xp', 'unlocked', 'at'])
        && request.resource.data.xp is int && request.resource.data.xp >= 0
        && request.resource.data.unlocked is list && request.resource.data.unlocked.size() <= 40
        && request.resource.data.at == request.time;
    }
    // Trophy ownership is mirrored separately so profile progress and collection data stay independent.
    match /trophies/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider in ['google.com', 'custom']
        && request.resource.data.keys().hasOnly(['name', 'trophies', 'regions', 'count', 'at'])
        && request.resource.data.keys().hasAll(['name', 'trophies', 'regions', 'count', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 12
        && request.resource.data.trophies is list && request.resource.data.trophies.size() <= 6
        && request.resource.data.trophies.hasOnly(['daejeon', 'sejong', 'busan', 'okcheon', 'seoul', 'attendance'])
        && request.resource.data.regions is list && request.resource.data.regions.size() <= 5
        && request.resource.data.regions.hasOnly(['daejeon', 'sejong', 'busan', 'okcheon', 'seoul'])
        && request.resource.data.count is int && request.resource.data.count == request.resource.data.trophies.size()
        && request.resource.data.at == request.time;
    }
    // 스핀코인과 라켓 강화는 진행 데이터와 분리한 개인 지갑에 저장한다.
    match /wallets/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider in ['google.com', 'custom']
        && request.resource.data.keys().hasOnly(['name', 'coins', 'racketEnhance', 'at'])
        && request.resource.data.keys().hasAll(['name', 'coins', 'racketEnhance', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 12
        && request.resource.data.coins is int && request.resource.data.coins >= 0
        && request.resource.data.racketEnhance is int && request.resource.data.racketEnhance >= 0 && request.resource.data.racketEnhance <= 100
        && request.resource.data.at == request.time;
    }
    // Latest daily attendance receipt. Players may read it, but only an admin may
    // correct it in the Firebase console; browser clients must never write rewards.
    match /attendance_records/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }
    // Public attendance leaderboard. Each signed-in player may update only their own row.
    match /attendance_leaderboard/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider in ['google.com', 'custom']
        && request.resource.data.keys().hasOnly(['name', 'days', 'character', 'at'])
        && request.resource.data.keys().hasAll(['name', 'days', 'character', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 12
        && request.resource.data.days is int && request.resource.data.days >= 1 && request.resource.data.days <= 36500
        && request.resource.data.character is string && request.resource.data.character.size() >= 1 && request.resource.data.character.size() <= 24
        && request.resource.data.at == request.time;
    }
    // 캐릭터 사용 통계: the public character-popularity board sums every
    // account's cumulative match count, while writes remain owner-only.
    match /character_usage/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider in ['google.com', 'custom']
        && request.resource.data.keys().hasOnly(['stats', 'at'])
        && request.resource.data.keys().hasAll(['stats', 'at'])
        && request.resource.data.stats is map
        && request.resource.data.at == request.time;
    }
    match /tournament_progress/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider in ['google.com', 'custom']
        && request.resource.data.keys().hasOnly(['name', 'ttl', 'cleared', 'wins', 'best', 'at'])
        && request.resource.data.keys().hasAll(['name', 'cleared', 'wins', 'best', 'at'])
        && (!('ttl' in request.resource.data) || request.resource.data.ttl is string && request.resource.data.ttl.size() <= 12)
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 12
        && request.resource.data.cleared is int && request.resource.data.cleared >= 0 && request.resource.data.cleared <= 10
        && request.resource.data.wins is int && request.resource.data.wins >= 0 && request.resource.data.wins <= 100000
        && request.resource.data.best is int && request.resource.data.best >= 0 && request.resource.data.best <= 6
        && request.resource.data.at == request.time;
    }
    // 레벨 랭킹: each signed-in player writes only its own row; anyone may read the board.
    match /levels/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider in ['google.com', 'custom']
        && request.resource.data.keys().hasOnly(['name', 'ttl', 'main', 'xp', 'chars', 'at'])
        && (!('main' in request.resource.data) || request.resource.data.main is string && request.resource.data.main.size() <= 12)
        && (!('ttl' in request.resource.data) || request.resource.data.ttl is string && request.resource.data.ttl.size() <= 12)
        && request.resource.data.keys().hasAll(['name', 'xp', 'chars', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 12
        && request.resource.data.xp is int && request.resource.data.xp >= 0
        && request.resource.data.chars is int && request.resource.data.chars >= 1 && request.resource.data.chars <= 40
        && request.resource.data.at == request.time;
    }
    // 🎖️ 랭크전 (AI): one row per signed-in player, only the owner writes; anyone may read the board.
    match /arank/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider in ['google.com', 'custom']
        && request.resource.data.keys().hasOnly(['name', 'ttl', 'mmr', 'w', 'l', 'at'])
        && request.resource.data.keys().hasAll(['name', 'mmr', 'w', 'l', 'at'])
        && (!('ttl' in request.resource.data) || request.resource.data.ttl is string && request.resource.data.ttl.size() <= 12)
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 12
        && request.resource.data.mmr is int && request.resource.data.mmr >= 0 && request.resource.data.mmr <= 5000
        && request.resource.data.w is int && request.resource.data.w >= 0 && request.resource.data.l is int && request.resource.data.l >= 0
        && request.resource.data.at == request.time;
    }
    // ✉️ 쪽지 (offline messages): any signed-in player leaves a note for another uid; only the recipient reads and removes it.
    match /inbox/{id} {
      allow create: if request.auth != null && request.auth.token.firebase.sign_in_provider in ['google.com', 'custom']
        && request.resource.data.keys().hasOnly(['to', 'from', 'name', 'text', 'at'])
        && request.resource.data.keys().hasAll(['to', 'from', 'name', 'text', 'at'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to.size() >= 1 && request.resource.data.to.size() <= 128
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 12
        && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 200
        && request.resource.data.at == request.time;
      allow read, delete: if request.auth != null && resource.data.to == request.auth.uid;
    }
    // A recipient may leave one read receipt for a real inbox row. Only the sender can see it.
    match /mail_reads/{id} {
      allow create: if request.auth != null && request.auth.token.firebase.sign_in_provider in ['google.com', 'custom']
        && request.resource.data.keys().hasOnly(['from', 'to', 'at'])
        && request.resource.data.keys().hasAll(['from', 'to', 'at'])
        && request.resource.data.to == request.auth.uid
        && request.resource.data.from == get(/databases/$(database)/documents/inbox/$(id)).data.from
        && request.resource.data.to == get(/databases/$(database)/documents/inbox/$(id)).data.to
        && request.resource.data.at == request.time;
      allow update: if request.auth != null && request.auth.token.firebase.sign_in_provider in ['google.com', 'custom'] && request.auth.uid == resource.data.to
        && request.resource.data.keys().hasOnly(['from', 'to', 'at'])
        && request.resource.data.from == resource.data.from && request.resource.data.to == resource.data.to
        && request.resource.data.at == request.time;
      allow read: if request.auth != null && resource.data.from == request.auth.uid;
      allow delete: if request.auth != null && resource.data.from == request.auth.uid;
    }
    match /players/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid && request.auth.token.firebase.sign_in_provider in ['google.com', 'custom'] && pvpShape(request.resource.data)
        && ((request.resource.data.wins == 1 && request.resource.data.losses == 0
             && request.resource.data.streak == 1 && request.resource.data.rating == 1010)
         || (request.resource.data.wins == 0 && request.resource.data.losses == 1
             && request.resource.data.streak == -1 && request.resource.data.rating == 990));
      allow update: if request.auth != null && request.auth.uid == uid && request.auth.token.firebase.sign_in_provider in ['google.com', 'custom'] && pvpShape(request.resource.data)
        && request.time > resource.data.at + duration.value(90, 's')
        && ((request.resource.data.wins == resource.data.wins + 1
             && request.resource.data.losses == resource.data.losses
             && request.resource.data.streak == (resource.data.streak > 0 ? resource.data.streak + 1 : 1)
             && request.resource.data.rating == resource.data.rating + 9 + request.resource.data.streak)
         || (request.resource.data.losses == resource.data.losses + 1
             && request.resource.data.wins == resource.data.wins
             && request.resource.data.streak == (resource.data.streak < 0 ? resource.data.streak - 1 : -1)
             && request.resource.data.rating == resource.data.rating - 9 + request.resource.data.streak));
    }
  }
}
